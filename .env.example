# ---- Cashfree (Developers > API Keys) ----
CF_ENV=SANDBOX            # SANDBOX while testing, PROD when live
CF_APP_ID=
CF_SECRET_KEY=

# ---- Your site (optional, e.g. https://yourdomain.com). Leave empty to auto-detect ----
SITE_URL=

# ---- Order alert on WhatsApp (Meta WhatsApp Cloud API) ----
OWNER_WHATSAPP=917617238330     # your number with country code, no +
WA_TOKEN=
WA_PHONE_ID=
WA_TEMPLATE=new_paid_order

# ---- Order alert on Telegram (optional backup, free) ----
TG_BOT_TOKEN=
TG_CHAT_ID=
